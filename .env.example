# Firebase Web SDK configuration placeholders only. Do not commit private credentials.
# Copying this file keeps Firebase as the default and shows a visible configuration
# error until these public values are supplied for the shared project.
VITE_ATTENDANCE_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional local Firestore emulator endpoint, e.g. 127.0.0.1:8080.
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# VITE_ATTENDANCE_URL must be the exact attendee route used by /qr.
VITE_ATTENDANCE_URL=
