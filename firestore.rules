rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(memberId) {
      return /databases/$(database)/documents/members/$(memberId);
    }

    function memberDocument(memberId) {
      return get(memberPath(memberId)).data;
    }

    function serviceSessionPath(serviceKey) {
      return /databases/$(database)/documents/serviceSessions/$(serviceKey);
    }

    function serviceSessionDocument(serviceKey) {
      return get(serviceSessionPath(serviceKey)).data;
    }

    function hasPublicMemberFields(data) {
      return data.keys().hasOnly(['memberId', 'displayLabel', 'searchName', 'sortKey', 'cohort'])
        && data.keys().hasAll(['memberId', 'displayLabel', 'searchName', 'sortKey']);
    }

    function isPublicMember(memberId, data) {
      return hasPublicMemberFields(data)
        && data.memberId == memberId
        && data.memberId is string
        && data.memberId.size() > 0
        && data.displayLabel is string
        && data.displayLabel.size() > 0
        && data.searchName is string
        && data.searchName.size() > 0
        && data.sortKey is string
        && data.sortKey.size() > 0
        && (
          !data.keys().hasAny(['cohort'])
          || (data.cohort is string && data.cohort.size() > 0)
        );
    }

    function isCurrentServiceConfig(data) {
      return data.keys().hasOnly(['serviceKey'])
        && data.keys().hasAll(['serviceKey'])
        && data.serviceKey is string;
    }

    function hasAttendanceFields() {
      return request.resource.data.keys().hasOnly([
          'memberId',
          'displayNameSnapshot',
          'serviceKey',
          'servicePart',
          'submittedAt',
          'createdAtClient',
        ])
        && request.resource.data.keys().hasAll([
          'memberId',
          'displayNameSnapshot',
          'serviceKey',
          'servicePart',
          'submittedAt',
        ]);
    }

    function hasAttendanceFieldTypes() {
      return request.resource.data.memberId is string
        && request.resource.data.memberId.size() > 0
        && request.resource.data.memberId.size() <= 128
        && request.resource.data.displayNameSnapshot is string
        && request.resource.data.displayNameSnapshot.size() > 0
        && request.resource.data.displayNameSnapshot.size() <= 200
        && request.resource.data.serviceKey is string
        && request.resource.data.serviceKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.submittedAt == request.time
        && request.resource.data.servicePart in [1, 2, 3]
        && (
          !request.resource.data.keys().hasAny(['createdAtClient'])
          || request.resource.data.createdAtClient is timestamp
        );
    }

    function hasAllowlistedMemberSnapshot() {
      return exists(memberPath(request.resource.data.memberId))
        && isPublicMember(
          request.resource.data.memberId,
          memberDocument(request.resource.data.memberId)
        )
        && memberDocument(request.resource.data.memberId).displayLabel
          == request.resource.data.displayNameSnapshot;
    }

    function hasServiceSession(serviceKey) {
      return exists(serviceSessionPath(serviceKey))
        && isCurrentServiceConfig(serviceSessionDocument(serviceKey))
        && serviceSessionDocument(serviceKey).serviceKey == serviceKey;
    }

    function usesKnownServiceKey(serviceKey) {
      return hasServiceSession(serviceKey)
        && request.resource.data.serviceKey == serviceKey;
    }

    function isAttendanceCreate(serviceKey) {
      return hasAttendanceFields()
        && hasAttendanceFieldTypes()
        && hasAllowlistedMemberSnapshot()
        && usesKnownServiceKey(serviceKey);
    }

    match /members/{memberId} {
      allow get: if isPublicMember(memberId, resource.data);
      // Name search is prefix-bounded in the client and capped here to keep
      // public reads small. Query rules are not filters, so the seed shape
      // remains a required data boundary.
      allow list: if request.query.limit != null
        && request.query.limit <= 10;
      allow create, update, delete: if false;
    }

    match /serviceConfig/currentServiceKey {
      allow get: if isCurrentServiceConfig(resource.data);
      allow list, create, update, delete: if false;
    }

    match /serviceConfig/{configId} {
      allow read, write: if false;
    }

    match /serviceSessions/{serviceKey} {
      allow get: if isCurrentServiceConfig(resource.data)
        && resource.data.serviceKey == serviceKey;
      allow list, create, update, delete: if false;
    }

    match /attendanceServices/{serviceKey}/submissions/{submissionId} {
      allow create: if submissionId == request.resource.data.memberId
        && isAttendanceCreate(serviceKey);
      allow get: if hasServiceSession(serviceKey)
        && resource.data.serviceKey == serviceKey;
      // The service path is the query boundary; do not add an unprovable
      // resource.data predicate to this list rule.
      allow list: if hasServiceSession(serviceKey)
        && request.query.limit != null
        && request.query.limit <= 2000;
      allow update, delete: if false;
    }
  }
}
